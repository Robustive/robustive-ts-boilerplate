{
  /* backendパッケージで tsc する際はこれを参照する。VSCode 向けに、ルートの tsconfig からも参照している */
  "compilerOptions": {
    "composite": true /* for Solution Style */,
    /**
     * incrementalビルドに必要な情報を出力しているファイルのパス。viteに合わせて変更しているが、
     * nest-cli.json で deleteOutDir : true にしている場合は一緒に消えて欲しいので dist以下に出るようにコメントアウト
     */
    // "tsBuildInfoFile": "../../node_modules/.tmp/backend.tsbuildinfo",
    "module": "CommonJS",
    "rootDir": "../../" /* VSCodeでのPROBLEMS（ts6059: 'rootDir' is expected to contain all source files.）対策 */,
    "baseUrl": "../../",
    "paths": {
      "@dependencies/*": ["src/dependencies/*"],
      "@domain/*": ["src/domain/*"],
      "@backend/*": ["src/implementation/backend/*"],
      "@shared/*": ["src/implementation/shared/*"]
    },
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ESNext",
    "sourceMap": true,
    "outDir": "../../dist/backend",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": false,
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "forceConsistentCasingInFileNames": false,
    "noFallthroughCasesInSwitch": false
  },
  "include": [
    "../../src/dependencies/**/*.ts",
    "../../src/dependencies/**/*.sql",
    "../../src/domain/**/*.ts",
    "../../src/implementation/backend/**/*.ts",
    "../../src/implementation/shared/**/*.ts"
  ],
  "ts-node": {
    "require": ["tsconfig-paths/register"]
  }
}
